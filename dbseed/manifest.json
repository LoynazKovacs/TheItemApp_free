{
  "version": 2,
  "appKey": "free",
  "appVersion": "1.0.0",
  "engineRequires": ">=1.0.0",
  "requiresCore": true,
  "collections": [
    {
      "collection": "apps",
      "file": "apps.json",
      "matchBy": "key",
      "installMode": "shared",
      "exportFields": ["key", "name", "description", "icon", "enabled", "groupIds", "ai"],
      "filter": { "key": "free" }
    },
    {
      "collection": "users",
      "file": "users.json",
      "matchBy": "_id",
      "installMode": "shared",
      "exportFields": ["username", "usernameLower", "isFunctional", "isSystem", "appId", "groupIds"]
    },
    {
      "collection": "items",
      "file": "items.json",
      "matchBy": "key",
      "installMode": "shared",
      "exportFields": [
        "key",
        "collection",
        "title",
        "titleSingular",
        "titlePlural",
        "description",
        "ai",
        "icon",
        "appId",
        "schema",
        "ui",
        "api",
        "auth",
        "tier",
        "kind"
      ],
      "filter": { "appId": "<thisAppId>" }
    },
    {
      "collection": "item_chart_views",
      "file": "item_chart_views.json",
      "matchBy": "_id",
      "installMode": "installConfig",
      "exportFields": ["modelId", "name", "data", "map", "builder", "isDefault", "pinned", "order", "systemManaged"]
    },
    {
      "collection": "item_tree_views",
      "file": "item_tree_views.json",
      "matchBy": "_id",
      "installMode": "installConfig",
      "exportFields": [
        "modelId",
        "name",
        "groupBy",
        "leafLimit",
        "rowDensity",
        "allowCreate",
        "showAvatar",
        "avatarField",
        "avatarShape",
        "showTitle",
        "titleField",
        "titleWeight",
        "showBadge",
        "badgeField",
        "showIcon",
        "showSubtitle",
        "subtitleField",
        "subtitleLines",
        "showContent",
        "contentField",
        "contentLines",
        "showRightTop",
        "rightTopField",
        "rightTopFormat",
        "rightTopActionKeys",
        "showRightMiddle",
        "rightMiddleField",
        "rightMiddleKind",
        "rightMiddleActionKeys",
        "showRightBottom",
        "rightBottomField",
        "rightBottomKind",
        "rightBottomActionKeys",
        "sortFields",
        "sortField",
        "sortDir",
        "clickActionKey",
        "isDefault",
        "pinned",
        "order",
        "systemManaged"
      ]
    },
    {
      "collection": "free_demo_weather",
      "file": "free_demo_weather.json",
      "matchBy": "_id",
      "installMode": "installStarterData",
      "exportFields": ["day", "date", "highC", "lowC", "condition", "precipMm"]
    },
    {
      "collection": "dashboards",
      "file": "dashboards.json",
      "matchBy": "_id",
      "installMode": "installConfig",
      "exportFields": ["appId", "name", "icon", "isHome", "interactive", "groupIds", "statusId", "gridsterConfigId", "tiles", "systemManaged"]
    },
    {
      "collection": "windows",
      "file": "windows.json",
      "matchBy": "_id",
      "installMode": "installConfig",
      "exportFields": ["dashboardId", "title", "icon", "groupIds", "modelId", "prefabId", "prefabConfig", "systemManaged"]
    },
    {
      "collection": "coding_agent_skills",
      "file": "coding_agent_skills.json",
      "matchBy": "_id",
      "installMode": "shared",
      "exportFields": ["key", "name", "description", "instructions", "tags", "categoryId", "repoId", "systemManaged", "groupIds"],
      "filter": { "key": "free-playground-visualization" }
    },
    {
      "collection": "chat_skills",
      "file": "chat_skills.json",
      "matchBy": "_id",
      "installMode": "shared",
      "exportFields": ["key", "name", "description", "instructions", "tags", "appId", "systemManaged", "groupIds"],
      "filter": { "appId": "<thisAppId>" }
    }
  ]
}
